df_g5 <- as.data.frame(tab_q6)
names(df_g5) <- c("Antecedent", "Statut", "Effectif")
df_g5$Total <- ave(df_g5$Effectif, df_g5$Antecedent, FUN = sum)
df_g5$Pourcentage <- 100 * df_g5$Effectif / df_g5$Total
df_g5$Axe <- paste0(df_g5$Antecedent, "\n(n = ", df_g5$Total, ")")
df_g5$Axe <- factor(df_g5$Axe, levels = unique(df_g5$Axe))
df_g5$Statut <- factor(ifelse(df_g5$Statut == "Oui", "Prééclampsie", "Absence de prééclampsie"),
levels = c("Absence de prééclampsie", "Prééclampsie"))
df_g5$Etiquette <- paste0(virgule(df_g5$Pourcentage), " %")
g5 <- ggplot(df_g5, aes(x = Axe, y = Pourcentage, fill = Statut)) +
geom_col(position = position_dodge(width = 0.7), width = 0.6) +
geom_text(aes(label = Etiquette), position = position_dodge(width = 0.7), vjust = -0.5, size = 3.8) +
scale_fill_manual(values = c(couleur_temoin, couleur_cas)) +
scale_y_continuous(limits = c(0, 105), expand = expansion(mult = c(0, 0))) +
labs(title = "Prééclampsie selon l'antécédent de prééclampsie",
subtitle = "Femmes déjà accouchées (parité >= 1) ; % calculé dans chaque groupe",
x = "Antécédent personnel de prééclampsie", y = "Pourcentage de femmes (%)",
fill = "Grossesse actuelle") +
theme_tfe
g5
