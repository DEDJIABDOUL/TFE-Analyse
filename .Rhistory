geom_histogram(binwidth = 2, boundary = 14, fill = couleur_principale, color = "white") +
labs(title = "Distribution de l'âge maternel",
subtitle = paste0("Femmes enceintes incluses (N = ", nrow(donnees), ", données synthétiques)"),
x = "Âge maternel (années)", y = "Effectif (nombre de femmes)") +
theme_tfe
g1
