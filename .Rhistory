# Fichier de synthèse des principaux résultats
taux_q5 <- paste0(rownames(tab_q5), " : ", virgule(100 * tab_q5[, "Oui"] / rowSums(tab_q5)), " %", collapse = " ; ")
synthese_resultats <- data.frame(
Question = paste0("Q", 1:10),
Resultat = c(
paste0("Âge moyen ", virgule(age_moyenne), " ans (écart-type ", virgule(age_ecart_type), ") ; médiane ",
age_mediane, " ; min ", age_min, " ; max ", age_max),
paste0("Niveau secondaire : ", virgule(100 * mean(donnees$niveau_instruction == "Secondaire", na.rm = TRUE)),
" % ; milieu urbain : ", virgule(100 * mean(donnees$milieu_residence == "Urbain")), " %"),
paste0("Parité moyenne ", virgule(mean(donnees$parite)), " ; CPN moyen ",
virgule(mean(donnees$nb_cpn, na.rm = TRUE)), " ; âge gestationnel moyen ",
virgule(mean(donnees$age_gestationnel_sa)), " SA"),
paste0(tab_pe["Oui"], " cas sur ", sum(tab_pe), " femmes (", virgule(pct_pe), " %)"),
paste0(methode_q5, ", p = ", virgule(p_q5, 3), " ; % de prééclampsie - ", taux_q5),
paste0(methode_q6, ", p = ", virgule(p_q6, 3), " ; avec antécédent : ",
virgule(100 * tab_q6["Oui", "Oui"] / sum(tab_q6["Oui", ])), " % ; sans antécédent : ",
virgule(100 * tab_q6["Non", "Oui"] / sum(tab_q6["Non", ])), " %"),
paste0(methode_q7, ", p = ", virgule(p_q7, 3), " ; avec HTA chronique : ",
virgule(100 * tab_q7["Oui", "Oui"] / sum(tab_q7["Oui", ])), " % ; sans : ",
virgule(100 * tab_q7["Non", "Oui"] / sum(tab_q7["Non", ])), " %"),
paste0(methode_q8, ", p = ", virgule(p_q8, 3), " ; nullipares : ",
virgule(100 * tab_q8[1, "Oui"] / sum(tab_q8[1, ])), " %"),
paste0(methode_q9, ", p = ", virgule(p_q9, 3), " ; grossesse multiple : ",
virgule(100 * tab_q9["Multiple", "Oui"] / sum(tab_q9["Multiple", ])), " % ; unique : ",
virgule(100 * tab_q9["Unique", "Oui"] / sum(tab_q9["Unique", ])), " %"),
paste0(methode_q10, ", p = ", virgule(p_q10, 3), " ; âge moyen ",
virgule(tableau_q10$Moyenne[2]), " ans (prééclampsie) contre ",
virgule(tableau_q10$Moyenne[1]), " ans (sans)")),
stringsAsFactors = FALSE)
write.csv2(synthese_resultats, file.path(dossier_tableaux, "Synthese_resultats.csv"),
row.names = FALSE, na = "", fileEncoding = "CP1252")
synthese_resultats
