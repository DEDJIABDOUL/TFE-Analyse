effectifs_groupes <- table(donnees$preeclampsie)
effectifs_groupes
tapply(donnees$age_ans, donnees$preeclampsie, mean, na.rm = TRUE)
tapply(donnees$age_ans, donnees$preeclampsie, sd, na.rm = TRUE)
tapply(donnees$age_ans, donnees$preeclampsie, median, na.rm = TRUE)
# Condition : au moins 30 femmes dans chaque groupe -> test t ; sinon test de Wilcoxon
if (min(effectifs_groupes) >= 30) {
methode_q10 <- "Test t de Student (Welch)"
test_q10 <- t.test(age_ans ~ preeclampsie, data = donnees)
} else {
methode_q10 <- "Wilcoxon"
test_q10 <- wilcox.test(age_ans ~ preeclampsie, data = donnees, exact = FALSE)
}
test_q10
p_q10 <- test_q10$p.value
cat("Test :", methode_q10, "; p-value =", virgule(p_q10, 3), "\n")
if (p_q10 < 0.05) {
cat("Conclusion : différence statistiquement significative (p < 0,05).\n")
} else {
cat("Conclusion : différence non démontrée ici (p >= 0,05). Cela ne prouve pas l'absence de différence.\n")
}
tableau_q10 <- data.frame(
Groupe     = c("Absence de prééclampsie", "Prééclampsie"),
Effectif   = as.vector(effectifs_groupes),
Moyenne    = round(as.vector(tapply(donnees$age_ans, donnees$preeclampsie, mean, na.rm = TRUE)), 1),
Ecart_type = round(as.vector(tapply(donnees$age_ans, donnees$preeclampsie, sd, na.rm = TRUE)), 1),
Mediane    = as.vector(tapply(donnees$age_ans, donnees$preeclampsie, median, na.rm = TRUE)))
tableau_q10
mise_en_forme <- function(tab, nom_facteur, methode, p) {
total <- as.vector(rowSums(tab))
cas   <- as.vector(tab[, "Oui"])
k     <- nrow(tab)
p_txt <- ifelse(p < 0.001, "<0,001", virgule(p, 3))
data.frame(Facteur = nom_facteur, Modalite = rownames(tab),
Effectif_total = total, Cas_preeclampsie = cas,
Pourcentage_cas = round(100 * cas / total, 1),
Test = c(methode, rep("", k - 1)), p_value = c(p_txt, rep("", k - 1)),
row.names = NULL)
}
tableau4 <- rbind(
mise_en_forme(tab_q5, "Âge maternel",                                       methode_q5, p_q5),
mise_en_forme(tab_q6, "Antécédent de prééclampsie (femmes déjà accouchées)", methode_q6, p_q6),
mise_en_forme(tab_q7, "HTA chronique",                                      methode_q7, p_q7),
mise_en_forme(tab_q8, "Parité",                                             methode_q8, p_q8),
mise_en_forme(tab_q9, "Type de grossesse",                                  methode_q9, p_q9))
tableau4
ligne_numerique <- function(x, nom) {
moy <- tapply(x, donnees$preeclampsie, mean, na.rm = TRUE)
et  <- tapply(x, donnees$preeclampsie, sd, na.rm = TRUE)
c(nom, paste0(virgule(moy["Oui"]), " (", virgule(et["Oui"]), ")"),
paste0(virgule(moy["Non"]), " (", virgule(et["Non"]), ")"))
}
ligne_categorique <- function(x, modalite, nom) {
n_mod <- tapply(x == modalite, donnees$preeclampsie, sum, na.rm = TRUE)
n_val <- tapply(!is.na(x), donnees$preeclampsie, sum)
pct   <- 100 * n_mod / n_val
c(nom, paste0(n_mod["Oui"], " (", virgule(pct["Oui"]), " %)"),
paste0(n_mod["Non"], " (", virgule(pct["Non"]), " %)"))
}
tableau5 <- as.data.frame(rbind(
ligne_numerique(donnees$age_ans,             "Âge maternel (ans), moyenne (écart-type)"),
ligne_numerique(donnees$imc,                 "IMC (kg/m2), moyenne (écart-type)"),
ligne_numerique(donnees$nb_cpn,              "Nombre de CPN, moyenne (écart-type)"),
ligne_numerique(donnees$age_gestationnel_sa, "Âge gestationnel (SA), moyenne (écart-type)"),
ligne_categorique(donnees$tranche_age, "Moins de 20 ans",  "Âge < 20 ans, n (%)"),
ligne_categorique(donnees$tranche_age, "35 ans et plus",   "Âge >= 35 ans, n (%)"),
ligne_categorique(donnees$groupe_parite, "Nullipare (0)",  "Nullipare, n (%)"),
ligne_categorique(donnees$atcd_hta_chronique, "Oui",       "HTA chronique, n (%)"),
ligne_categorique(donnees$atcd_familial_hta, "Oui",        "Antécédent familial d'HTA, n (%)"),
ligne_categorique(donnees$atcd_diabete, "Oui",             "Diabète préexistant, n (%)"),
ligne_categorique(donnees$type_grossesse, "Multiple",      "Grossesse multiple, n (%)")),
stringsAsFactors = FALSE)
names(tableau5) <- c("Caracteristique",
paste0("Prééclampsie (n = ", effectifs_groupes["Oui"], ")"),
paste0("Absence de prééclampsie (n = ", effectifs_groupes["Non"], ")"))
tableau5
synthese_tests <- data.frame(
Question = c("Q5 Âge (tranches) x prééclampsie", "Q6 Antécédent de prééclampsie x prééclampsie",
"Q7 HTA chronique x prééclampsie", "Q8 Parité x prééclampsie",
"Q9 Grossesse multiple x prééclampsie", "Q10 Âge moyen selon le statut"),
Test = c(methode_q5, methode_q6, methode_q7, methode_q8, methode_q9, methode_q10),
Effectif_attendu_min = round(c(min(attendus_q5), min(attendus_q6), min(attendus_q7),
min(attendus_q8), min(attendus_q9), NA), 1),
p_value = round(c(p_q5, p_q6, p_q7, p_q8, p_q9, p_q10), 6))
synthese_tests$p_value_affichee <- ifelse(synthese_tests$p_value < 0.001, "<0,001",
virgule(synthese_tests$p_value, 3))
synthese_tests$Conclusion <- ifelse(synthese_tests$p_value < 0.05,
"Association (ou différence) statistiquement significative",
"Non significatif : absence d'association non prouvée")
synthese_tests
theme_tfe <- theme_classic(base_size = 12) +
theme(plot.title = element_text(face = "bold", size = 13),
plot.title.position = "plot",
plot.subtitle = element_text(color = "grey30"),
axis.text = element_text(color = "black"),
legend.position = "bottom")
couleur_principale <- "#0097B2"   # bleu-vert : couleur principale
couleur_cas        <- "#FF0000"   # rouge : femmes avec prééclampsie
couleur_temoin     <- "#0097B2"   # bleu-vert : femmes sans prééclampsie
