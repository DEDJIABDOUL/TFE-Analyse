library(ggplot2)
stop("Fichier de données introuvable. Ouvrez le projet : File > Open Project > Atelier_TFE.Rproj")
if (file.exists("01_DONNEES/donnees_TFE_preeclampsie_Kara.csv")) {
dossier_projet <- "."
} else if (file.exists("../01_DONNEES/donnees_TFE_preeclampsie_Kara.csv")) {
dossier_projet <- ".."
} else {
stop("Fichier de données introuvable. Ouvrez le projet : File > Open Project > Atelier_TFE.Rproj")
}
dossier_tableaux   <- file.path(dossier_projet, "05_RESULTATS", "tableaux")
dossier_graphiques <- file.path(dossier_projet, "05_RESULTATS", "graphiques")
dir.create(dossier_tableaux,   showWarnings = FALSE, recursive = TRUE)
dir.create(dossier_graphiques, showWarnings = FALSE, recursive = TRUE)
# 1.4 Importer le fichier CSV (séparateur ";" : read.csv2)
donnees <- read.csv2(file.path(dossier_projet, "01_DONNEES", "donnees_TFE_preeclampsie_Kara.csv"),
stringsAsFactors = FALSE, fileEncoding = "UTF-8")
# 1.6 Petits outils (ils fabriquent des tableaux propres ; pas besoin de les comprendre pour commencer)
virgule <- function(x, d = 1) formatC(x, format = "f", digits = d, decimal.mark = ",")
faire_tableau <- function(x, nom) {
effectifs <- table(x)
pct <- round(100 * prop.table(effectifs), 1)
tab <- data.frame(Variable = nom, Modalite = names(effectifs),
Effectif = as.vector(effectifs), Pourcentage = as.vector(pct))
manquants <- sum(is.na(x))
if (manquants > 0) {
tab <- rbind(tab, data.frame(Variable = nom, Modalite = "Données manquantes",
Effectif = manquants, Pourcentage = NA))
}
return(tab)
}
# ==========================================================================
# SECTION 2 : EXPLORATION DU DATASET
# ==========================================================================
dim(donnees)               # nombre de lignes (patientes) et de colonnes (variables)
names(donnees)             # noms des variables
str(donnees)               # type de chaque variable (num, int, chr)
summary(donnees)           # résumé de chaque variable
colSums(is.na(donnees))    # nombre de valeurs manquantes par variable
# 2.1 Préparer les variables qualitatives (ordre logique des modalités)
donnees$niveau_instruction <- factor(donnees$niveau_instruction,
levels = c("Aucun", "Primaire", "Secondaire", "Supérieur"))
donnees$milieu_residence   <- factor(donnees$milieu_residence, levels = c("Urbain", "Rural"))
donnees$type_grossesse     <- factor(donnees$type_grossesse, levels = c("Unique", "Multiple"))
donnees$atcd_preeclampsie  <- factor(donnees$atcd_preeclampsie, levels = c("Non", "Oui", "Non applicable"))
donnees$atcd_hta_chronique <- factor(donnees$atcd_hta_chronique, levels = c("Non", "Oui"))
donnees$atcd_familial_hta  <- factor(donnees$atcd_familial_hta, levels = c("Non", "Oui"))
donnees$atcd_diabete       <- factor(donnees$atcd_diabete, levels = c("Non", "Oui"))
donnees$preeclampsie       <- factor(donnees$preeclampsie, levels = c("Non", "Oui"))
donnees$type_diagnostic    <- factor(donnees$type_diagnostic,
levels = c("Normotendue", "HTA gestationnelle", "HTA chronique seule",
"Prééclampsie", "Prééclampsie surajoutée"))
# 2.2 Créer de nouvelles variables (regroupements en classes)
donnees$tranche_age <- cut(donnees$age_ans, breaks = c(0, 19, 29, 34, 100),
labels = c("Moins de 20 ans", "20-29 ans", "30-34 ans", "35 ans et plus"))
donnees$groupe_parite <- cut(donnees$parite, breaks = c(-1, 0, 2, 20),
labels = c("Nullipare (0)", "1-2 accouchements", "3 accouchements et plus"))
donnees$groupe_cpn <- cut(donnees$nb_cpn, breaks = c(-1, 3, 7, 20),
labels = c("Moins de 4 CPN", "4 à 7 CPN", "8 CPN et plus"))
donnees$groupe_age_gest <- cut(donnees$age_gestationnel_sa, breaks = c(0, 27, 36, 50),
labels = c("20-27 SA", "28-36 SA", "37 SA et plus"))
# QUESTION 1 : Quel est l'âge moyen des femmes enceintes incluses dans l'étude ?
age_moyenne    <- mean(donnees$age_ans, na.rm = TRUE)
age_moyenne
age_ecart_type <- sd(donnees$age_ans, na.rm = TRUE)
age_ecart_type
age_mediane    <- median(donnees$age_ans, na.rm = TRUE)
age_min        <- min(donnees$age_ans, na.rm = TRUE)
age_max        <- max(donnees$age_ans, na.rm = TRUE)
age_max
cat("Âge moyen :", virgule(age_moyenne), "ans (écart-type :", virgule(age_ecart_type), ")\n")
cat("Médiane :", age_mediane, "ans ; minimum :", age_min, "; maximum :", age_max, "\n")
tableau_q1 <- data.frame(
Statistique = c("Effectif valide", "Moyenne", "Ecart-type", "Médiane", "Minimum", "Maximum"),
Valeur = c(sum(!is.na(donnees$age_ans)), round(age_moyenne, 1), round(age_ecart_type, 1),
age_mediane, age_min, age_max))
tableau_q1
tableau1 <- rbind(
faire_tableau(donnees$tranche_age,             "Tranche d'âge"),
faire_tableau(donnees$situation_matrimoniale,  "Situation matrimoniale"),
faire_tableau(donnees$niveau_instruction,      "Niveau d'instruction"),
faire_tableau(donnees$profession,              "Profession"),
faire_tableau(donnees$milieu_residence,        "Milieu de résidence"))
tableau1
variables_obst <- donnees[, c("gestite", "parite", "nb_cpn", "age_gestationnel_sa")]
summary(variables_obst)
tableau2_quanti <- data.frame(
Variable   = c("Gestité", "Parité", "Nombre de CPN", "Âge gestationnel (SA)"),
N_valides  = colSums(!is.na(variables_obst)),
Moyenne    = round(sapply(variables_obst, mean, na.rm = TRUE), 1),
Ecart_type = round(sapply(variables_obst, sd, na.rm = TRUE), 1),
Mediane    = sapply(variables_obst, median, na.rm = TRUE),
Minimum    = sapply(variables_obst, min, na.rm = TRUE),
Maximum    = sapply(variables_obst, max, na.rm = TRUE),
row.names  = NULL)
tableau2_quanti
tableau2_categories <- rbind(
faire_tableau(donnees$groupe_parite,   "Parité"),
faire_tableau(donnees$groupe_cpn,      "Nombre de CPN"),
faire_tableau(donnees$groupe_age_gest, "Âge gestationnel"))
tableau2_categories
tab_pe <- table(donnees$preeclampsie)
tab_pe
pct_pe <- 100 * tab_pe["Oui"] / sum(tab_pe)
cat("Prééclampsie :", tab_pe["Oui"], "cas sur", sum(tab_pe), "femmes, soit", virgule(pct_pe), "%\n")
# ATTENTION : ce pourcentage concerne l'échantillon, pas toute la population de Kara.
tableau3 <- rbind(
faire_tableau(donnees$preeclampsie,    "Prééclampsie (toutes formes)"),
faire_tableau(donnees$type_diagnostic, "Type de diagnostic"))
tableau3
# QUESTION 5 : Existe-t-il une association entre l'âge maternel et la prééclampsie ?
tab_q5 <- table(donnees$tranche_age, donnees$preeclampsie)
tab_q5
round(100 * prop.table(tab_q5, 1), 1)                    # % de prééclampsie dans chaque tranche d'âge
attendus_q5 <- outer(rowSums(tab_q5), colSums(tab_q5)) / sum(tab_q5)
round(attendus_q5, 1)                                    # effectifs attendus sous H0
if (min(attendus_q5) >= 5) {
methode_q5 <- "Chi-deux"
test_q5 <- chisq.test(tab_q5, correct = FALSE)
} else {
methode_q5 <- "Fisher"
test_q5 <- fisher.test(tab_q5)
}
test_q5
p_q5 <- test_q5$p.value
cat("Test :", methode_q5, "; p-value =", virgule(p_q5, 3), "\n")
if (p_q5 < 0.05) {
cat("Conclusion : association statistiquement significative (p < 0,05).\n")
} else {
cat("Conclusion : association non démontrée ici (p >= 0,05). Cela ne prouve pas l'absence d'association.\n")
}
# QUESTION 6 : Les femmes ayant un antécédent de prééclampsie présentent-elles plus
#              souvent une prééclampsie ? (seulement les femmes déjà accouchées)
multipares <- donnees[donnees$parite >= 1 & donnees$atcd_preeclampsie %in% c("Oui", "Non"), ]
multipares <- droplevels(multipares)
nrow(multipares)                                         # effectif analysé
tab_q6 <- table(multipares$atcd_preeclampsie, multipares$preeclampsie)
tab_q6
round(100 * prop.table(tab_q6, 1), 1)
attendus_q6 <- outer(rowSums(tab_q6), colSums(tab_q6)) / sum(tab_q6)
round(attendus_q6, 1)
if (min(attendus_q6) >= 5) {
methode_q6 <- "Chi-deux"
test_q6 <- chisq.test(tab_q6, correct = FALSE)
} else {
methode_q6 <- "Fisher"
test_q6 <- fisher.test(tab_q6)
}
test_q6
p_q6 <- test_q6$p.value
cat("Test :", methode_q6, "; p-value =", virgule(p_q6, 3), "\n")
if (p_q6 < 0.05) {
cat("Conclusion : association statistiquement significative (p < 0,05).\n")
} else {
cat("Conclusion : association non démontrée ici (p >= 0,05). Cela ne prouve pas l'absence d'association.\n")
}
